  background-color: #FF9800;
}

.status-dot.danger {
  background-color: #FF6B6B;
}

.activity-section {
  flex-direction: column;
  width: 100%;
  background-color: #1a1a1a;
  border-radius: 12px;
  padding: 12px;
  margin-bottom: 12px;
}

.activity-header {
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 8px;
}

.section-title {
  font-size: 18px;
  color: #ffffff;
  font-weight: bold;
}

