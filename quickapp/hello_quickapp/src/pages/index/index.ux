  font-size: 12px;
  padding-left: 6px;
  padding-right: 6px;
  padding-top: 2px;
  padding-bottom: 2px;
  border-radius: 8px;
  margin-right: 8px;
}

.upload-badge.http {
  color: #FFFFFF;
  background-color: #2196F3;
}

.upload-badge.mqtt {
  color: #FFFFFF;
  background-color: #4CAF50;
}

.sos-section {
  flex-direction: row;
  justify-content: center;
  margin-bottom: 12px;
}

.sos-button {
  width: 80px;
  height: 40px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: #FF6B6B;
  border-radius: 20px;
}

