<template>
  <div class="container">
    <scroll scroll-y="true" class="scroll-container">
      <div class="content">
        <!-- 状态栏 -->
        <div class="status-bar">
          <text class="time-text">{{ currentTime }}</text>
          <div class="status-icons">
            <text class="upload-badge {{ uploadMode }}">{{ uploadMode === 'mqtt' ? 'MQTT' : 'HTTP' }}</text>
            <text class="data-source-badge {{ dataSource }}">{{ dataSource === 'mock' ? '模拟' : '实时' }}</text>
            <text class="battery-text">{{ batteryLevel }}%</text>
            <div class="settings-btn" onclick="onSettingsTap">
              <image src="/common/images/icons/settings.png" class="settings-icon"></image>
            </div>
          </div>
        </div>

        <!-- SOS 按钮 -->
        <div class="sos-section">
          <div class="sos-button" onclick="onSOSPress">
            <image src="/common/images/icons/sos.png" class="sos-icon"></image>
            <text class="sos-text">SOS</text>
          </div>
        </div>

        <!-- 体征数据卡片 -->
        <div class="vital-cards">
          <div class="vital-card" onclick="onVitalTap('heartRate')">
            <image src="/common/images/icons/heart-rate.png" class="vital-icon"></image>
            <div class="vital-info">
              <text class="vital-label">心率</text>
              <text class="vital-value">{{ heartRateDisplay }}</text>
            </div>
            <div class="status-dot {{ heartRateStatus }}"></div>
          </div>

          <div class="vital-card" onclick="onVitalTap('spo2')">
            <image src="/common/images/icons/spo2.png" class="vital-icon"></image>
            <div class="vital-info">
              <text class="vital-label">血氧</text>
              <text class="vital-value">{{ spo2Display }}</text>
            </div>
            <div class="status-dot {{ spo2Status }}"></div>
          </div>

          <div class="vital-card" onclick="onVitalTap('temperature')">
            <image src="/common/images/icons/temperature.png" class="vital-icon"></image>
            <div class="vital-info">
              <text class="vital-label">体温</text>
              <text class="vital-value">{{ temperatureDisplay }}</text>
            </div>
            <div class="status-dot {{ temperatureStatus }}"></div>
          </div>
        </div>

        <!-- 活动统计 -->
        <div class="activity-section">
          <div class="activity-header">
            <text class="section-title">今日活动</text>
          </div>
          <div class="activity-stats">
            <div class="stat-item">
              <image src="/common/images/icons/steps.png" class="stat-icon"></image>
              <text class="stat-value">{{ steps }}</text>
              <text class="stat-label">步数</text>
            </div>
            <div class="stat-item">
              <text class="stat-value">{{ activeMinutes }}</text>
              <text class="stat-label">分钟</text>
            </div>
            <div class="stat-item">
              <text class="stat-value">{{ calories }}</text>
              <text class="stat-label">千卡</text>
            </div>
          </div>
          <div class="progress-bar">
            <div class="progress-fill" style="width: {{ progressWidth }}px"></div>
          </div>
        </div>

        <!-- 健康提示 -->
        <div class="health-tip" if="{{ healthTipMessage }}">
          <text class="tip-text {{ healthTipLevel }}">{{ healthTipMessage }}</text>
        </div>
      </div>
    </scroll>
  </div>
</template>

<style>
.container {
  width: 466px;
  height: 466px;
  flex-direction: column;
  background-color: #000000;
}

.scroll-container {
  width: 466px;
  height: 466px;
  flex-direction: column;
}

.content {
  flex-direction: column;
  padding: 65px;
  padding-left: 65px;
  padding-right: 65px;
}

.status-bar {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.time-text {
  font-size: 20px;
  color: #999999;
}

.status-icons {
  flex-direction: row;
  align-items: center;
}

.battery-text {
  font-size: 18px;
  color: #999999;
  margin-right: 8px;
}

