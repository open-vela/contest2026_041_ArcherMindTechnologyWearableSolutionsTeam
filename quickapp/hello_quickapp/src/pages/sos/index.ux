<template>
  <div class="container">
    <!-- 标题 -->
    <text class="sos-title">紧急求助</text>

    <!-- SOS 大按钮：长按触发 -->
    <div class="sos-button"
         ontouchstart="onSOSPress"
         ontouchend="onSOSRelease">
      <text class="sos-label" if="{{ !isTriggered }}">SOS</text>
      <text class="sos-label" if="{{ isTriggered }}">发送中…</text>
    </div>

    <!-- 底部提示 -->
    <text class="sos-hint" if="{{ !isTriggered }}">长按触发</text>
    <text class="sos-hint" if="{{ isTriggered }}">正在联系家人</text>
  </div>
</template>

<style>
.container {
  width: 466px;
  height: 466px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #7f1d1d 0%, #450a0a 100%);
  padding-top: 70px;
  padding-bottom: 70px;
  padding-left: 60px;
  padding-right: 60px;
}

.sos-title {
  font-size: 32px;
  color: #fca5a5;
  font-weight: 700;
  margin-bottom: 28px;
}

.sos-button {
  width: 200px;
  height: 200px;
  border-radius: 100px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #ef4444 0%, #b91c1c 100%);
  border-width: 6px;
  border-color: #f87171;
}

.sos-label {
  font-size: 56px;
  color: #ffffff;
  font-weight: 700;
}

.sos-hint {
  font-size: 22px;
  color: #fca5a5;
  margin-top: 28px;
}
</style>

<script>
import router from '@system.router'
import vibrator from '@system.vibrator'
import geolocation from '@system.geolocation'
import storage from '@system.storage'
import { STORAGE_KEYS } from '../../utils/constants'
import UploadService from '../../services/UploadService'
import AlarmService from '../../services/AlarmService'

export default {
  protected: {
    sosData: ''
  },

  private: {
    isTriggered: false,
    heartRate: '--',
    spo2: '--',
    temperature: '--',
    hasLocation: false,
    sosPacket: null,
    uploadService: null,
    alarmService: null,
    longPressTimer: null,
    longPressThreshold: 1500
  },

  onInit() {
    this.initServices()
    this.parseSOSData()
  },

  onDestroy() {
    this.stopLongPress()
    this.cleanupServices()
  },

  /**
   * 初始化服务
   */
  initServices() {
    this.uploadService = new UploadService()
    this.uploadService.init({})

    this.alarmService = new AlarmService(this.uploadService)
    this.alarmService.init({})
  },

  /**
   * 解析 SOS 数据
   */
  parseSOSData() {
    if (this.sosData) {
      try {
        this.sosPacket = JSON.parse(this.sosData)
        this.heartRate = this.sosPacket.heartRate || '--'
        this.spo2 = this.sosPacket.spo2 || '--'
        this.temperature = this.sosPacket.temperature || '--'
        this.hasLocation = !!this.sosPacket.location
      } catch (e) {
        console.error('解析 SOS 数据失败:', e)
        this.initDefaultData()
      }
    } else {
      this.initDefaultData()
    }
  },

  /**
   * 初始化默认数据
   */
  initDefaultData() {
    this.sosPacket = {
      type: 'sos',
      level: 'P0',
      timestamp: Date.now(),
      heartRate: -1,
      spo2: -1,
      temperature: -1,
      location: null,
      context: {
        triggerType: 'manual',
        deviceTime: Date.now()
      }
    }

    this.getCurrentLocation()
  },

  /**
   * 获取当前位置
   */
  getCurrentLocation() {
    geolocation.getLocation({
      success: (data) => {
        this.sosPacket.location = {
          latitude: data.latitude,
          longitude: data.longitude
        }
        this.hasLocation = true
      },
      fail: (data, code) => {
        console.error(`获取位置失败: code=${code}`)
        this.hasLocation = false
      }
    })
  },

  /**
   * 停止长按计时
   */
  stopLongPress() {
    if (this.longPressTimer) {
      clearTimeout(this.longPressTimer)
      this.longPressTimer = null
    }
  },

  /**
   * SOS 按钮按下（启动长按计时）
   */
  onSOSPress() {
    vibrator.vibrate({
      mode: 'short',
      success: () => {},
      fail: () => {}
    })

    this.longPressTimer = setTimeout(() => {
      this.triggerSOS()
    }, this.longPressThreshold)
  },

  /**
   * SOS 按钮松开（取消长按）
   */
  onSOSRelease() {
    this.stopLongPress()
  },

  /**
   * 触发 SOS 报警
   */
  triggerSOS() {
    if (this.isTriggered) return

    this.stopLongPress()
    this.isTriggered = true

    vibrator.vibrate({
      mode: 'long',
      success: () => {},
      fail: (data, code) => {
        console.error(`震动失败: code=${code}`)
      }
    })

    this.saveAlarmRecord()
    this.uploadAlarmData()

    setTimeout(() => {
      this.returnToHome()
    }, 3000)
  },

  /**
   * 保存报警记录
   */
  saveAlarmRecord() {
    storage.get({
      key: STORAGE_KEYS.SOS_RECORDS,
      success: (data) => {
        let records = []
        if (data) {
          try {
            records = JSON.parse(data)
          } catch (e) {
            records = []
          }
        }

        records.push(this.sosPacket)

        if (records.length > 100) {
          records = records.slice(-100)
        }

        storage.set({
          key: STORAGE_KEYS.SOS_RECORDS,
          value: JSON.stringify(records),
          success: () => {},
          fail: () => {
            console.error('保存报警记录失败')
          }
        })
      },
      fail: () => {
        console.error('读取报警记录失败')
        storage.set({
          key: STORAGE_KEYS.SOS_RECORDS,
          value: JSON.stringify([this.sosPacket]),
          success: () => {},
          fail: () => {
            console.error('保存报警记录失败')
          }
        })
      }
    })
  },

  /**
   * 上传报警数据
   */
  uploadAlarmData() {
    this.uploadService.uploadAlarm(this.sosPacket)
  },

  /**
   * 返回首页
   */
  returnToHome() {
    router.back()
  },

  /**
   * 清理服务
   */
  cleanupServices() {
    if (this.uploadService) {
      this.uploadService.stop()
    }
    if (this.alarmService) {
      this.alarmService.stop()
    }
    vibrator.stop({
      success: () => {},
      fail: () => {}
    })
  }
}
</script>
