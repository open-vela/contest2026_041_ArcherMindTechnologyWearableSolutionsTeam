<template>
  <scroll scroll-y="true" class="scroll-container">
    <div class="container">
      <!-- SOS 报警页面 -->
      <div class="sos-content">
      <!-- 倒计时显示 -->
      <div class="countdown-section">
        <text class="countdown-number">{{ countdown }}</text>
        <text class="countdown-label">秒后发送报警</text>
      </div>

      <!-- 报警状态 -->
      <div class="status-section" if="{{ isTriggered }}">
        <text class="status-text">正在发送报警...</text>
        <text class="status-sub">请保持冷静，救援即将到达</text>
      </div>

      <!-- 体征数据显示 -->
      <div class="vital-section">
        <div class="vital-row">
          <text class="vital-label">心率</text>
          <text class="vital-value">{{ heartRate }} bpm</text>
        </div>
        <div class="vital-row">
          <text class="vital-label">血氧</text>
          <text class="vital-value">{{ spo2 }}%</text>
        </div>
        <div class="vital-row">
          <text class="vital-label">体温</text>
          <text class="vital-value">{{ temperature }}°C</text>
        </div>
      </div>

      <!-- 位置信息 -->
      <div class="location-section" if="{{ hasLocation }}">
        <text class="location-text">已获取位置信息</text>
      </div>

      <!-- 取消按钮 -->
      <div class="cancel-section">
        <div class="cancel-button" onclick="onCancelSOS">
          <text class="cancel-text">取消报警</text>
        </div>
      </div>
    </div>
  </div>
  </scroll>
</template>

<style>
.scroll-container {
  width: 466px;
  height: 466px;
  flex-direction: column;
}

.container {
  width: 466px;
  flex-direction: column;
  background-color: #000000;
}

.sos-content {
  flex-direction: column;
  align-items: center;
  padding-top: 65px;
  padding-bottom: 65px;
  padding-left: 65px;
  padding-right: 65px;
}

.countdown-section {
  flex-direction: column;
  align-items: center;
  margin-bottom: 20px;
}

.countdown-number {
  font-size: 60px;
  color: #FF6B6B;
  font-weight: bold;
}

.countdown-label {
  font-size: 18px;
  color: #999999;
  margin-top: 8px;
}

.status-section {
  flex-direction: column;
  align-items: center;
  margin-bottom: 16px;
}

.status-text {
  font-size: 24px;
  color: #FF6B6B;
  font-weight: bold;
}

.status-sub {
  font-size: 16px;
  color: #999999;
  margin-top: 8px;
}

.vital-section {
  flex-direction: column;
  background-color: #1a1a1a;
  border-radius: 12px;
  padding: 12px;
  margin-bottom: 16px;
  width: 100%;
}

.vital-row {
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 8px;
}

.vital-label {
  font-size: 18px;
  color: #999999;
}

.vital-value {
  font-size: 18px;
  color: #ffffff;
  font-weight: bold;
}

.location-section {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}

.location-text {
  font-size: 14px;
  color: #4CAF50;
}

.cancel-section {
  flex-direction: row;
  justify-content: center;
}

.cancel-button {
  width: 140px;
  height: 50px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: #333333;
  border-radius: 25px;
}

.cancel-text {
  font-size: 20px;
  color: #ffffff;
}
</style>

<script>
import router from '@system.router'
import vibrator from '@system.vibrator'
import geolocation from '@system.geolocation'
import storage from '@system.storage'
import { STORAGE_KEYS } from '../../utils/constants'
import UploadService from '../../services/UploadService'
import AlarmService from '../../services/AlarmService'

export default {
  protected: {
    sosData: ''
  },

  private: {
    countdown: 10,
    isTriggered: false,
    heartRate: '--',
    spo2: '--',
    temperature: '--',
    hasLocation: false,
    countdownTimer: null,
    sosPacket: null,
    uploadService: null,
    alarmService: null
  },

  onInit() {
    this.initServices()
    this.parseSOSData()
    this.startCountdown()
  },

  onDestroy() {
    this.stopCountdown()
    this.cleanupServices()
  },

  /**
   * 初始化服务
   */
  initServices() {
    this.uploadService = new UploadService()
    this.uploadService.init({})

    this.alarmService = new AlarmService(this.uploadService)
    this.alarmService.init({})
  },

  /**
   * 解析 SOS 数据
   */
  parseSOSData() {
    if (this.sosData) {
      try {
        this.sosPacket = JSON.parse(this.sosData)
        this.heartRate = this.sosPacket.heartRate || '--'
        this.spo2 = this.sosPacket.spo2 || '--'
        this.temperature = this.sosPacket.temperature || '--'
        this.hasLocation = !!this.sosPacket.location
      } catch (e) {
        console.error('解析 SOS 数据失败:', e)
        this.initDefaultData()
      }
    } else {
      this.initDefaultData()
    }
  },

  /**
   * 初始化默认数据
   */
  initDefaultData() {
    this.sosPacket = {
      type: 'sos',
      level: 'P0',
      timestamp: Date.now(),
      heartRate: -1,
      spo2: -1,
      temperature: -1,
      location: null,
      context: {
        triggerType: 'manual',
        deviceTime: Date.now()
      }
    }

    // 获取当前位置
    this.getCurrentLocation()
  },

  /**
   * 获取当前位置
   */
  getCurrentLocation() {
    geolocation.getLocation({
      success: (data) => {
        this.sosPacket.location = {
          latitude: data.latitude,
          longitude: data.longitude
        }
        this.hasLocation = true
      },
      fail: (data, code) => {
        console.error(`获取位置失败: code=${code}`)
        this.hasLocation = false
      }
    })
  },

  /**
   * 开始倒计时
   */
  startCountdown() {
    this.countdownTimer = setInterval(() => {
      this.countdown--

      if (this.countdown <= 0) {
        this.triggerSOS()
      }
    }, 1000)
  },

  /**
   * 停止倒计时
   */
  stopCountdown() {
    if (this.countdownTimer) {
      clearInterval(this.countdownTimer)
      this.countdownTimer = null
    }
  },

  /**
   * 触发 SOS 报警
   */
  triggerSOS() {
    this.stopCountdown()
    this.isTriggered = true

    // 持续震动
    vibrator.vibrate({
      mode: 'long',
      success: () => {},
      fail: (data, code) => {
        console.error(`震动失败: code=${code}`)
      }
    })

    // 保存报警记录
    this.saveAlarmRecord()

    // 上传报警数据
    this.uploadAlarmData()

    // 3秒后返回首页
    setTimeout(() => {
      this.returnToHome()
    }, 3000)
  },

  /**
   * 保存报警记录
   */
  saveAlarmRecord() {
    storage.get({
      key: STORAGE_KEYS.SOS_RECORDS,
      success: (data) => {
        let records = []
        if (data) {
          try {
            records = JSON.parse(data)
          } catch (e) {
            records = []
          }
        }

        records.push(this.sosPacket)

        // 最多保存 100 条记录
        if (records.length > 100) {
          records = records.slice(-100)
        }

        storage.set({
          key: STORAGE_KEYS.SOS_RECORDS,
          value: JSON.stringify(records),
          success: () => {},
          fail: (data, code) => {
            console.error(`保存报警记录失败: code=${code}`)
          }
        })
      },
      fail: (data, code) => {
        console.error(`读取报警记录失败: code=${code}`)
        storage.set({
          key: STORAGE_KEYS.SOS_RECORDS,
          value: JSON.stringify([this.sosPacket]),
          success: () => {},
          fail: (data, code) => {
            console.error(`保存报警记录失败: code=${code}`)
          }
        })
      }
    })
  },

  /**
   * 上传报警数据
   */
  uploadAlarmData() {
    this.uploadService.uploadAlarm(this.sosPacket)
  },

  /**
   * 取消 SOS 报警
   */
  onCancelSOS() {
    this.stopCountdown()
    vibrator.stop({
      success: () => {},
      fail: (data, code) => {}
    })
    this.returnToHome()
  },

  /**
   * 返回首页
   */
  returnToHome() {
    router.back()
  },

  /**
   * 清理服务
   */
  cleanupServices() {
    if (this.uploadService) {
      this.uploadService.stop()
    }
    if (this.alarmService) {
      this.alarmService.stop()
    }
    vibrator.stop({
      success: () => {},
      fail: (data, code) => {}
    })
  }
}
</script>
