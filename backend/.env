# ============================================================
# AI老年健康守护系统 — 环境变量配置
# 复制此文件为 .env 并修改敏感信息后部署
#   Windows: copy .env.example .env
#   Linux:   cp .env.example .env
# ============================================================

# ---------- 运行环境 ----------
# 可选值: production | staging | development
ENVIRONMENT=production

# ---------- 数据库 ----------
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=elderly_health

# ---------- JWT ----------
# 生产环境务必修改！生成方式: openssl rand -hex 32
JWT_SECRET=elderly-health-jwt-secret-change-in-prod-2026

# ---------- 管理员默认账号 ----------
# 首次部署时自动创建，首次登录后强制要求修改密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@2026

# ---------- MQTT (EMQX) ----------
# EMQX Dashboard 管理员密码
EMQX_DASHBOARD_PASSWORD=public

# ---------- 通知服务（可选，不填仅跳过通知） ----------
# 短信服务 (阿里云/腾讯云 SMS)
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=老年健康守护
SMS_TEMPLATE_CODE=

# 推送服务 (个推/极光)
PUSH_APP_ID=
PUSH_APP_KEY=
PUSH_APP_SECRET=

# 电话通知服务
PHONE_API_KEY=
PHONE_API_SECRET=

# ---------- 120 联动（可选） ----------
EMERGENCY_PHONE=120
EMERGENCY_ENDPOINT=
EMERGENCY_API_KEY=

# ---------- AI 服务 ----------
# OpenAI-compatible API（用于健康周报生成）
AI_API_ENDPOINT=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
