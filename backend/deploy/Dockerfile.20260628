# ===== emergency-service =====
FROM alpine:3.19 AS emergency-service
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /build/emergency-service /app/emergency-service
WORKDIR /app
USER 1000:1000
EXPOSE 8009
ENTRYPOINT ["./emergency-service"]
