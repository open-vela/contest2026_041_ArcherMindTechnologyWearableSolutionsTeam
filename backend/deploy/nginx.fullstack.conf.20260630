resolver 127.0.0.11 ipv6=off valid=30s;

upstream frontend_upstream {
    server frontend:80;
    keepalive 16;
}

upstream admin_auth_upstream {
    server admin-auth-service:8011;
    keepalive 8;
}

upstream user_upstream {
    server user-service:8001;
    keepalive 8;
}

upstream device_upstream {
    server device-service:8002;
    keepalive 8;
}

upstream vital_upstream {
    server vital-service:8003;
    keepalive 8;
}

upstream alarm_upstream {
    server alarm-service:8004;
    keepalive 8;
}

upstream signin_upstream {
    server signin-service:8005;
    keepalive 8;
}

upstream patrol_upstream {
    server patrol-service:8006;
    keepalive 8;
}

upstream notify_upstream {
    server notify-service:8007;
    keepalive 8;
}

upstream report_upstream {
    server report-service:8008;
    keepalive 8;
}

upstream dashboard_upstream {
    server dashboard-service:8010;
    keepalive 8;
}

server {
    listen 80;
    server_name _;
    charset utf-8;
    client_max_body_size 10m;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;

    location ^~ /api/v1/auth/ {
        rewrite ^/api/v1/auth/(.*) /v1/admin/$1 break;
        proxy_pass http://admin_auth_upstream;
    }
    location ^~ /api/v1/admin/ {
        rewrite ^/api/v1/admin/(.*) /v1/admin/$1 break;
        proxy_pass http://admin_auth_upstream;
    }
    location ^~ /api/v1/elderly {
        rewrite ^/api/v1/elderly(.*) /v1/elderly$1 break;
        proxy_pass http://user_upstream;
    }
    location ^~ /api/v1/vitals {
        rewrite ^/api/v1/vitals(.*) /v1/vitals$1 break;
        proxy_pass http://vital_upstream;
    }
    location ^~ /api/v1/devices {
        rewrite ^/api/v1/devices(.*) /v1/devices$1 break;
        proxy_pass http://device_upstream;
    }
    location ^~ /api/v1/alarms {
        rewrite ^/api/v1/alarms(.*) /v1/alarms$1 break;
        proxy_pass http://alarm_upstream;
    }
    location ^~ /api/v1/signin {
        rewrite ^/api/v1/signin(.*) /v1/signin$1 break;
        proxy_pass http://signin_upstream;
    }
    location ^~ /api/v1/patrol {
        rewrite ^/api/v1/patrol(.*) /v1/patrol$1 break;
        proxy_pass http://patrol_upstream;
    }
    location ^~ /api/v1/notify {
        rewrite ^/api/v1/notify(.*) /v1/notify$1 break;
        proxy_pass http://notify_upstream;
    }
    location ^~ /api/v1/reports {
        rewrite ^/api/v1/reports(.*) /v1/reports$1 break;
        proxy_pass http://report_upstream;
    }
    location ^~ /api/v1/dashboard {
        rewrite ^/api/v1/dashboard(.*) /v1/dashboard$1 break;
        proxy_pass http://dashboard_upstream;
    }
    location ^~ /api/v1/system {
        rewrite ^/api/v1/system(.*) /v1/system$1 break;
        proxy_pass http://dashboard_upstream;
    }
    location ^~ /api/ {
        return 404 '{"code":10001,"message":"接口不存在"}';
        add_header Content-Type application/json;
    }

    location /ws {
        proxy_pass http://admin_auth_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400s;
    }

    location /health {
        access_log off;
        return 200 '{"status":"ok"}';
        add_header Content-Type application/json;
    }

    location / {
        proxy_pass http://frontend_upstream;
    }
}
