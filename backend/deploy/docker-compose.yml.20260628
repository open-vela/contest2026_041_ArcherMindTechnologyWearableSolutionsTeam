# ============================================================
# AI 老年健康守护系统 — 全栈 Docker Compose
# 适配腾讯云 4核4GB 演示服务器
# 服务清单：前端(Nginx) + 12个后端微服务 + MySQL + Redis + EMQX
# ============================================================

services:

  # ============ 数据库（内存限制 512m，演示版配置） ============
  mysql:
    image: mysql:8.0.35
    container_name: ehc-mysql
    restart: always
    mem_limit: 512m
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD:-root123456}
      MYSQL_DATABASE: elderly_health
      MYSQL_CHARSET: utf8mb4
      MYSQL_COLLATION: utf8mb4_unicode_ci
    ports:
      - "3306:3306"
    volumes:
      - mysql_data:/var/lib/mysql
      - ../migrations:/docker-entrypoint-initdb.d
    command:
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_unicode_ci
      - --default-time-zone=+00:00
      - --max-connections=200
      - --innodb-buffer-pool-size=256M
      - --innodb-log-file-size=64M
      - --tmp-table-size=32M
      - --max-heap-table-size=32M
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

  # ============ 缓存（内存限制 128m） ============
  redis:
    image: redis:7.2-alpine
    container_name: ehc-redis
    restart: always
    mem_limit: 128m
    ports:
      - "6379:6379"
    command: redis-server --appendonly yes --maxmemory 96mb --maxmemory-policy allkeys-lru
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5

  # ============ MQTT Broker（内存限制 256m） ============
  emqx:
    image: emqx/emqx:5.3.0
    container_name: ehc-emqx
    restart: always
    mem_limit: 256m
    ports:
      - "1883:1883"     # MQTT（手表端连接）
      - "8883:8883"     # MQTT over SSL
      - "8083:8083"     # MQTT WebSocket
      - "18083:18083"   # EMQX Dashboard
    environment:
      EMQX_NAME: emqx
      EMQX_HOST: 127.0.0.1
      EMQX_NODE__PROCESS_LIMIT: 262144
      EMQX_NODE__MAX_PORTS: 1024
    volumes:
      - emqx_data:/opt/emqx/data
      - emqx_log:/opt/emqx/log
    healthcheck:
      test: ["CMD", "/opt/emqx/bin/emqx", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

  # ============ 用户服务 ============
  user-service:
    build:
      context: ..
      dockerfile: deploy/Dockerfile
      target: user-service
    container_name: ehc-user-service
    restart: always
    mem_limit: 128m
    ports:
      - "8001:8001"
    environment:
      EHC_SERVER_PORT: 8001
      EHC_MYSQL_HOST: mysql
      EHC_REDIS_HOST: redis
      JWT_SECRET: ${JWT_SECRET:-your-secret-key-change-in-production}
    depends_on:
      mysql:
        condition: service_healthy
      redis:
        condition: service_healthy

  # ============ 设备服务 ============
  device-service:
    build:
      context: ..
      dockerfile: deploy/Dockerfile
      target: device-service
    container_name: ehc-device-service
    restart: always
    mem_limit: 128m
    ports:
      - "8002:8002"
    environment:
      EHC_SERVER_PORT: 8002
      EHC_MYSQL_HOST: mysql
      EHC_MYSQL_PORT: 3306
      EHC_MYSQL_USER: root
      EHC_MYSQL_PASSWORD: root123456
      EHC_MYSQL_DATABASE: elderly_health
      EHC_REDIS_HOST: redis
      EHC_MQTT_BROKER: tcp://emqx:1883
      JWT_SECRET: ${JWT_SECRET:-your-secret-key-change-in-production}
    depends_on:
      mysql:
        condition: service_healthy
      redis:
        condition: service_healthy
      emqx:
        condition: service_healthy

  # ============ 体征服务 ============
  vital-service:
    build:
      context: ..
      dockerfile: deploy/Dockerfile
      target: vital-service
    container_name: ehc-vital-service
    restart: always
    mem_limit: 128m
    ports:
      - "8003:8003"
    environment:
      EHC_SERVER_PORT: 8003
      EHC_MYSQL_HOST: mysql
      EHC_REDIS_HOST: redis
      EHC_MQTT_BROKER: tcp://emqx:1883
      JWT_SECRET: ${JWT_SECRET:-your-secret-key-change-in-production}
    depends_on:
      mysql:
        condition: service_healthy
      redis:
        condition: service_healthy
      emqx:
        condition: service_healthy

  # ============ 报警服务 ============
  alarm-service:
    build:
      context: ..
      dockerfile: deploy/Dockerfile
      target: alarm-service
    container_name: ehc-alarm-service
    restart: always
    mem_limit: 128m
    ports:
      - "8004:8004"
    environment:
      EHC_SERVER_PORT: 8004
      EHC_MYSQL_HOST: mysql
      EHC_MYSQL_PORT: 3306
      EHC_MYSQL_USER: root
      EHC_MYSQL_PASSWORD: root123456
      EHC_MYSQL_DATABASE: elderly_health
      EHC_REDIS_HOST: redis
      JWT_SECRET: ${JWT_SECRET:-your-secret-key-change-in-production}
    depends_on:
      mysql:
        condition: service_healthy
      redis:
        condition: service_healthy

  # ============ 签到服务 ============
  signin-service:
    build:
      context: ..
      dockerfile: deploy/Dockerfile
      target: signin-service
    container_name: ehc-signin-service
    restart: always
    mem_limit: 128m
    ports:
      - "8005:8005"
    environment:
      EHC_SERVER_PORT: 8005
      EHC_MYSQL_HOST: mysql
      EHC_REDIS_HOST: redis
      EHC_MQTT_BROKER: tcp://emqx:1883
      JWT_SECRET: ${JWT_SECRET:-your-secret-key-change-in-production}
    depends_on:
      mysql:
        condition: service_healthy
      redis:
        condition: service_healthy
      emqx:
        condition: service_healthy

  # ============ 巡访服务 ============
  patrol-service:
    build:
      context: ..
      dockerfile: deploy/Dockerfile
      target: patrol-service
    container_name: ehc-patrol-service
    restart: always
    mem_limit: 128m
    ports:
      - "8006:8006"
    environment:
      EHC_SERVER_PORT: 8006
      EHC_MYSQL_HOST: mysql
      EHC_REDIS_HOST: redis
      JWT_SECRET: ${JWT_SECRET:-your-secret-key-change-in-production}
    depends_on:
      mysql:
        condition: service_healthy
      redis:
        condition: service_healthy

  # ============ 通知服务 ============
  notify-service:
    build:
      context: ..
      dockerfile: deploy/Dockerfile
      target: notify-service
    container_name: ehc-notify-service
    restart: always
    mem_limit: 128m
    ports:
      - "8007:8007"
    environment:
      EHC_SERVER_PORT: 8007
      EHC_MYSQL_HOST: mysql
      EHC_REDIS_HOST: redis
      JWT_SECRET: ${JWT_SECRET:-your-secret-key-change-in-production}
    depends_on:
      mysql:
        condition: service_healthy
      redis:
        condition: service_healthy

  # ============ 周报服务 ============
  report-service:
    build:
      context: ..
      dockerfile: deploy/Dockerfile
      target: report-service
    container_name: ehc-report-service
    restart: always
    mem_limit: 128m
    ports:
      - "8008:8008"
    environment:
      EHC_SERVER_PORT: 8008
      EHC_MYSQL_HOST: mysql
      EHC_REDIS_HOST: redis
      JWT_SECRET: ${JWT_SECRET:-your-secret-key-change-in-production}
    depends_on:
      mysql:
        condition: service_healthy
      redis:
        condition: service_healthy

  # ============ 应急服务 ============
  emergency-service:
    build:
      context: ..
      dockerfile: deploy/Dockerfile
      target: emergency-service
    container_name: ehc-emergency-service
    restart: always
    mem_limit: 128m
    ports:
      - "8009:8009"
    environment:
      EHC_SERVER_PORT: 8009
      EHC_MYSQL_HOST: mysql
      EHC_REDIS_HOST: redis
      JWT_SECRET: ${JWT_SECRET:-your-secret-key-change-in-production}
    depends_on:
      mysql:
        condition: service_healthy
      redis:
        condition: service_healthy

  # ============ 看板服务 ============
  dashboard-service:
    build:
      context: ..
      dockerfile: deploy/Dockerfile
      target: dashboard-service
    container_name: ehc-dashboard-service
    restart: always
    mem_limit: 128m
    ports:
      - "8010:8010"
    environment:
      EHC_SERVER_PORT: 8010
      EHC_MYSQL_HOST: mysql
      EHC_REDIS_HOST: redis
      JWT_SECRET: ${JWT_SECRET:-your-secret-key-change-in-production}
    depends_on:
      mysql:
        condition: service_healthy
      redis:
        condition: service_healthy

  # ============ 管理员认证服务 ============
  admin-auth-service:
    build:
      context: ..
      dockerfile: deploy/Dockerfile
      target: admin-auth-service
    container_name: ehc-admin-auth-service
    restart: always
    mem_limit: 128m
    ports:
      - "8011:8011"
    environment:
      EHC_SERVER_PORT: 8011
      EHC_MYSQL_HOST: mysql
      EHC_REDIS_HOST: redis
      JWT_SECRET: ${JWT_SECRET:-your-secret-key-change-in-production}
    depends_on:
      mysql:
        condition: service_healthy
      redis:
        condition: service_healthy

  # ============ 前端管理台（Nginx + React 静态文件）============
  frontend:
    build:
      context: ../../web-admin-react
      dockerfile: deploy/Dockerfile
      args:
        # 相对路径为空 => 使用 Nginx 内部反向代理到 api-gateway
        VITE_API_BASE_URL: /api/v1
        VITE_WS_URL: ws://${SERVER_IP:-localhost}/ws
        VITE_APP_TITLE: AI老年健康守护系统
    container_name: ehc-frontend
    restart: always
    mem_limit: 64m
    # 前端不直接对外，通过 api-gateway 的 Nginx 统一对外
    expose:
      - "80"
    depends_on:
      - admin-auth-service
      - user-service
      - dashboard-service

  # ============ API 网关（同时反代前端 + 后端 API）============
  api-gateway:
    image: nginx:1.25-alpine
    container_name: ehc-api-gateway
    restart: always
    mem_limit: 64m
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx.fullstack.conf:/etc/nginx/conf.d/default.conf:ro
      - ./proxy_params.conf:/etc/nginx/conf.d/proxy_params.conf:ro
      - ./proxy_params.conf:/etc/nginx/conf.d/proxy_params.conf:ro
      - ./proxy_params.conf:/etc/nginx/conf.d/proxy_params.conf:ro
    depends_on:
      - frontend
      - user-service
      - device-service
      - vital-service
      - alarm-service
      - signin-service
      - patrol-service
      - notify-service
      - report-service
      - emergency-service
      - dashboard-service
      - admin-auth-service

volumes:
  mysql_data:
  redis_data:
  emqx_data:
  emqx_log:
